  "private": true,
  "description": "A local-first Muslim life companion",
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 0.0.0.0",
    "test": "node tests/browser.cjs",
    "test:optional": "node tests/optional.cjs",
    "test:sources": "node tests/sources.cjs",
    "test:phase2": "node tests/phase2.cjs",
    "test:release": "node tests/release.cjs",
    "test:all": "npm test && npm run test:phase2 && npm run test:release && npm run test:sources && npm run test:optional && npm run test:native && npm run test:native-browser && npm run test:paths",
    "build:web": "node tools/build-web.mjs",
    "android:sync": "npm run build:web && cap sync android",
    "test:native": "node tests/native.cjs",
    "test:paths": "node tests/paths.cjs",
    "test:native-browser": "node tests/native-browser.cjs"
  },
  "devDependencies": {
